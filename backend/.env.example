# Node
NODE_ENV=development
PORT=5000

# PostgreSQL (Neon in production; local for development)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pharmatrack?schema=public"

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=30d

# Bootstrap
ADMIN_SETUP_CODE="PharmaAdmin-2026"

# Web app origin(s), comma-separated
CORS_ORIGINS=*

# bcrypt cost
BCRYPT_ROUNDS=12

# Seed demo data on boot (development only)
SEED_DEMO=false